<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Release / main: HTTPS only (cleartext denied).
      Debug builds overlay cleartext for local API via debug/res/xml.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

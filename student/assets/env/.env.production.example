# Production template — copy to assets/env/.env.production (gitignored) or
# supply values via CI `--dart-define`. Do NOT commit real secrets.
APP_ENV=production
API_BASE_URL=https://api.example.com/api/v1
APP_NAME=Pragyu
STUDENT_WEB_BASE_URL=https://student.example.com
# Auth email deep links also accept custom scheme pragyu://reset-password and pragyu://verify-email.
# Android App Links hosts are registered for student.pragyu.com / pragyu.com / www / app (see AndroidManifest).
SUPPORT_EMAIL=support@pragyu.in
PRIVACY_URL=https://pragyu.in/privacy
TERMS_URL=https://pragyu.in/terms
